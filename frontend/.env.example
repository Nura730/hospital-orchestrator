# MediOrchestra Frontend Environment Variables
# Copy this file to .env and fill in values

# Backend API base URL (leave blank to use Vite proxy)
VITE_API_URL=http://localhost:3001/api/v1

# Socket.IO server URL
VITE_SOCKET_URL=http://localhost:3001

# Enable mock mode (true = no backend needed, uses faker data)
VITE_USE_MOCK=true
