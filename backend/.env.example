PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediorchestra?sslmode=disable
JWT_SECRET=mediorchestra_super_secure_jwt_secret_key_2024_minimum_32_characters_long
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
SOCKET_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
SIMULATOR=true
LOG_LEVEL=info
BCRYPT_ROUNDS=10

# ── Predictive Flow Intelligence ─────────────────────────────────────
# Flow dashboards poll every 30 s; raise the global API limit for demos (e.g. RATE_LIMIT_MAX=2000)
FLOW_ANALYSIS_INTERVAL_MS=60000
PREDICTION_HORIZON_HOURS=6
# Leave the two thresholds empty to auto-pick from COUNT(beds):
#   <50 beds: 0.65/0.78   50-200: 0.75/0.88   200+: 0.82/0.92
BOTTLENECK_WARN_THRESHOLD=
BOTTLENECK_DANGER_THRESHOLD=
DISCHARGE_NUDGE_THRESHOLD=0.60
AMBULANCE_RESERVATION_HORIZON=30
AI_PROVIDER=gemini                 # gemini | groq
GEMINI_API_KEY=                    # free key: aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash      # configurable; use any currently free model
GROQ_API_KEY=                      # free key: console.groq.com/keys (comma-separate several keys for failover)
GROQ_MODEL=llama-3.3-70b-versatile # configurable
AI_REPORT_MAX_TOKENS=900
