{
  "name": "mediorchestra-backend",
  "version": "1.0.0",
  "description": "Production-ready Hospital Management System Backend for MediOrchestra",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:schema": "node -e \"require('./db/schema').run()\"",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/reset.js",
    "db:setup": "npm run db:schema && npm run db:seed",
    "test": "jest --runInBand",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "db:migrate:flow": "node db/migrateFlow.js",
    "seed:flow": "node db/flowSeed.js",
    "db:setup:flow": "npm run db:migrate:flow && npm run seed:flow"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.1",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
